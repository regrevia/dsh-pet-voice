<?xml version="1.0" encoding="utf-8"?>
<!--
  选择层的一行：左边两行字（标题 / 时间与状态），右边可有箭头。
  行与行之间用 1px 分割线隔开，靠留白与描边分层次，不用卡片阴影。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pickerRowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/pet_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/pickerRowMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/pet_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/pickerRowChevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="›"
            android:textColor="@color/pet_hint"
            android:textSize="17sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/pickerRowLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:background="@color/pet_line" />
</LinearLayout>
