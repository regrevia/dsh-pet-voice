<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/historyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pet_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/historyBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="返回"
                android:padding="9dp"
                android:src="@drawable/ic_back"
                android:tint="@color/pet_text_dim" />

            <!-- 左上：项目名 + 这一问落到哪个会话（会话名只在有时显示） -->
            <LinearLayout
                android:id="@+id/historyHead"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingTop="7dp"
                android:paddingEnd="4dp"
                android:paddingBottom="7dp">

                <TextView
                    android:id="@+id/historyProject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/pet_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/historySession"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/pet_hint"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/historyPeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/pet_hint"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageView
                android:id="@+id/historySessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="会话"
                android:padding="9dp"
                android:src="@drawable/ic_list"
                android:tint="@color/pet_text_dim" />

            <ImageView
                android:id="@+id/historyNew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="新对话"
                android:padding="9dp"
                android:src="@drawable/ic_plus"
                android:tint="@color/pet_accent" />

        </LinearLayout>

        <!-- 目标 + 待输入队列：和桌面端一样看得见，并且能直接操作 -->
        <LinearLayout
            android:id="@+id/historyGoalBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_goal_bar"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="9dp"
            android:paddingEnd="12dp"
            android:paddingBottom="9dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/goalState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pet_accent"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/goalText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/pet_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/goalAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/pet_accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/goalQueue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/pet_hint"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/historyList"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:listSelector="@android:color/transparent"
                android:paddingTop="6dp"
                android:paddingBottom="12dp"
                android:scrollbars="none"
                android:stackFromBottom="true" />

            <TextView
                android:id="@+id/historyEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:padding="24dp"
                android:text="说句话开始"
                android:textColor="@color/pet_hint"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chatTyping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="6dp"
                android:text="···"
                android:textColor="@color/pet_hint"
                android:textSize="18sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chatToBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_goal_bar"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="回到底部"
                android:textColor="@color/pet_accent"
                android:textSize="12sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 选好还没发的图：一张一个缩略图，点 × 去掉 -->
        <HorizontalScrollView
            android:id="@+id/chatTrayScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/chatTray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/chatRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/chatRunText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="处理中"
                android:textColor="@color/pet_hint"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chatSteer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:text="引导"
                android:textColor="@color/pet_accent"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chatStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:text="中断"
                android:textColor="@color/pet_accent"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 还没轮到跑的那几句：一行一条，撤掉/调顺序都在这一行里 -->
        <LinearLayout
            android:id="@+id/chatQueue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <EditText
                android:id="@+id/chatInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical|start"
                android:hint="发消息"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="46dp"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp"
                android:textColor="@color/pet_text"
                android:textColorHint="@color/pet_hint"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/chatAttach"
                android:layout_width="40dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="发图片或视频"
                android:padding="10dp"
                android:src="@drawable/ic_plus"
                android:tint="@color/pet_text_dim" />

            <ImageView
                android:id="@+id/chatEmoji"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_input"
                android:contentDescription="表情"
                android:padding="12dp"
                android:src="@drawable/ic_emoji"
                android:tint="@color/pet_text_dim" />

            <ImageView
                android:id="@+id/chatMic"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_input"
                android:contentDescription="按住说话"
                android:padding="12dp"
                android:src="@drawable/ic_mic"
                android:tint="@color/pet_text_dim" />

            <ImageView
                android:id="@+id/chatSend"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_primary"
                android:contentDescription="发送"
                android:padding="12dp"
                android:src="@drawable/ic_send"
                android:tint="@color/pet_bg" />
        </LinearLayout>
    </LinearLayout>

    <!-- 两级选择器：一级项目、二级该项目会话；整层盖住，返回键先关它 -->
    <View
        android:id="@+id/pickerScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/pickerSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_sheet"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/pickerBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="项目"
                android:padding="9dp"
                android:src="@drawable/ic_back"
                android:tint="@color/pet_text_dim"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pickerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:text="项目"
                android:textColor="@color/pet_text"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/pickerClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="关闭"
                android:padding="9dp"
                android:src="@drawable/ic_close"
                android:tint="@color/pet_accent" />
        </LinearLayout>

        <ListView
            android:id="@+id/pickerList"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:listSelector="@android:color/transparent"
            android:maxHeight="520dp"
            android:scrollbars="none" />
    </LinearLayout>
</FrameLayout>
