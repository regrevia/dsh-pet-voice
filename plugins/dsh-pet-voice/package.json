{
  "name": "dsh-pet-voice",
  "version": "0.1.32",
  "description": "手机端语音宠物：DSH 的 App 端 + 桌宠玩法，语音唤醒与对话；局域网 / 自建域名 / 服务器中转三种连法，人在外面也能指挥电脑上的 DSH。",
  "type": "module",
  "engines": {
    "node": ">=22.15.0",
    "dsh": ">=0.2.0"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "files": [
    "README.md",
    "client.js",
    "cordis.patch.yml",
    "index.js",
    "panel.mjs",
    "lan.mjs",
    "public.mjs",
    "guardPath.mjs",
    "selftest.mjs",
    "public/",
    "tts/",
    "asr/"
  ],
  "author": {
    "name": "regrevia",
    "url": "https://github.com/regrevia"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regrevia/dsh-pet-voice.git",
    "directory": "plugins/dsh-pet-voice"
  },
  "homepage": "https://github.com/regrevia/dsh-pet-voice#readme",
  "bugs": {
    "url": "https://github.com/regrevia/dsh-pet-voice/issues"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "pet",
    "voice",
    "asr",
    "tts",
    "android"
  ]
}
